# Telegram bot token from BotFather
BOT_TOKEN=

# AI provider for the medical web assistant: polza (recommended) or huggingface
AI_PROVIDER=polza

# Polza.ai OpenAI-compatible API (key starts with pza_; never commit the real key)
POLZA_API_KEY=
POLZA_MODEL=qwen/qwen3.5-9b
POLZA_CHAT_COMPLETIONS_URL=https://polza.ai/api/v1/chat/completions

# Optional Hugging Face fallback
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_CHAT_COMPLETIONS_URL=https://router.huggingface.co/v1/chat/completions

# Optional Yandex OAuth. Needed only for DOCUMENT_STORAGE_BACKEND=yandex.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://YOUR-DOMAIN.example/oauth/yandex/callback
YANDEX_ROOT_FOLDER=MedArchive

# Encrypts Yandex tokens and OCR text/keywords in SQLite.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Web UI test account. Set a long unique password in the server's .env.
WEB_USERNAME=admin
WEB_PASSWORD=
# Shared public demo account. Change or disable before production exposure.
DEMO_USERNAME=test
DEMO_PASSWORD=test

# Storage backend: local (default) or yandex
DOCUMENT_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/data/documents

# Runtime configuration
DB_PATH=/app/data/archive.sqlite3
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100
ALLOWED_TELEGRAM_IDS=
LOG_LEVEL=INFO
OAUTH_BIND_HOST=127.0.0.1
OAUTH_BIND_PORT=8080

# AI document classification is invoked only when a user explicitly consents on upload.
AI_CLASSIFICATION_ENABLED=true
DEMO_MAX_ACTIVE_TENANTS=20
DEMO_MAX_DOCUMENTS=10
DEMO_MAX_PATIENTS=10
DEMO_MAX_UPLOAD_MB=5