# Telegram bot token from BotFather
BOT_TOKEN=

# Hugging Face Inference Providers (optional during initial tests)
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_CHAT_COMPLETIONS_URL=https://router.huggingface.co/v1/chat/completions

# Yandex Disk OAuth application (for per-family cloud connections)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://YOUR-DOMAIN.example/oauth/yandex/callback

# Encryption key for stored per-family OAuth tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Runtime configuration
DB_PATH=data/archive.sqlite3
UPLOAD_TMP_DIR=data/tmp
MAX_UPLOAD_MB=20
ALLOWED_TELEGRAM_IDS=
LOG_LEVEL=INFO
