# Telegram bot token from BotFather
BOT_TOKEN=

# Hugging Face Inference Providers (optional; paid usage is separate from VPS)
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_CHAT_COMPLETIONS_URL=https://router.huggingface.co/v1/chat/completions

# Register an app in Yandex OAuth. Redirect URI must match exactly.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://YOUR-DOMAIN.example/oauth/yandex/callback
YANDEX_ROOT_FOLDER=MedArchive

# Encrypts both family Yandex tokens and OCR text/keywords in SQLite.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Runtime configuration
DB_PATH=data/archive.sqlite3
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100
ALLOWED_TELEGRAM_IDS=
LOG_LEVEL=INFO
# The callback is reverse-proxied by Nginx over HTTPS.
OAUTH_BIND_HOST=127.0.0.1
OAUTH_BIND_PORT=8080
